{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Auto merge patch container updates',
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      matchUpdateTypes: [
        'digest',
        'patch',
      ],
    },
    {
      description: 'Auto merge renovate container',
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      matchUpdateTypes: [
        'digest',
        'patch',
        'minor',
      ],
      matchPackageNames: [
        '/docker.io/renovate/renovate/',
      ],
    },
    {
      description: 'Auto merge runner container',
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      matchUpdateTypes: [
        'digest',
        'patch',
        'minor',
        'major',
      ],
      matchPackageNames: [
        '/ghcr.io/heathcliff26/runner/',
      ],
    },
  ],
}
