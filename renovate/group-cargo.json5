{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "groupName": "cargo",
      "groupSlug": "all-cargo-crates",
      "matchManagers": ["cargo"],
    },
    {
      "groupName": "builder",
      "groupSlug": "builder-image",
      "matchPackageNames": [
        "ghcr.io/heathcliff26/rust-builder",
        "ghcr.io/heathcliff26/rust-qt-builder",
        ],
    },
  ]
}
