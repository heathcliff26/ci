{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "groupName": "gomod",
      "groupSlug": "all-gomod-dependencies",
      "matchManagers": ["gomod"],
    },
    {
      "groupName": "builder",
      "groupSlug": "builder-image",
      "matchPackageNames": ["ghcr.io/heathcliff26/go-fyne-ci"],
    },
  ]
}
